# Copiar a .env y completar. NUNCA subir .env al repositorio.
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=portal_user
DB_PASSWORD=cambiar_esta_clave
DB_NAME=portal_escuela
# Cadena larga y aleatoria: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambiar_por_un_valor_aleatorio_largo
# Minutos de inactividad antes de expirar la sesión
SESSION_MINUTOS=30
# En producción con HTTPS: true
COOKIE_SECURE=false

# URL pública del portal (para los enlaces de los correos)
APP_URL=http://localhost:3000
# Correo saliente (opcional; sin SMTP_HOST no se envían correos)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Escuela Normal <no-responder@tu-dominio.edu.ar>"
